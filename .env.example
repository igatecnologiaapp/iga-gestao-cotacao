# =============================================================================
# IGA Tecnologia — App de Cotação Rápida
# Modelo de variáveis de ambiente. NUNCA colocar credenciais reais aqui.
# =============================================================================

# -----------------------------------------------------------------------------
# BUILD-TIME / FRONTEND (embutidas no bundle — apenas valores publicáveis)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# SERVER RUNTIME (nunca use prefixo VITE_ nestas variáveis)
# Usadas pelas funções de servidor (leitura por imagem, SSR).
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# -----------------------------------------------------------------------------
# INTELIGÊNCIA (opcional) — somente servidor
# Sem credencial, o aplicativo funciona normalmente e apenas "Ler etiqueta" e
# "Ler cartão de visita" ficam indisponíveis, com aviso de preenchimento manual.
# -----------------------------------------------------------------------------
# lovable | openai | custom (informativo)
AI_PROVIDER=
# Padrão: https://ai.gateway.lovable.dev/v1
AI_BASE_URL=
# Padrão: openai/gpt-5.6-sol
AI_MODEL=
# Credencial do provedor — fornecer como secret de runtime, nunca versionar
AI_API_KEY=

# Compatibilidade: usado quando AI_API_KEY não é fornecida (gateway Lovable)
LOVABLE_API_KEY=

# -----------------------------------------------------------------------------
# EXECUÇÃO (container)
# -----------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=3000
